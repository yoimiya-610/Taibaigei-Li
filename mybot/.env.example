# Copy this file to .env and fill in only values for your own deployment.
# Startup preflight validates these service settings before the port is bound.
HOST=127.0.0.1
PORT=8081
COMMAND_START=["/"]

# Optional capabilities: blank values never expose secrets in startup output.
DEEPSEEK_API_KEY=
ONEBOT_ACCESS_TOKEN=
BOT_ADMINS=
DAILY_GREET_GROUPS=
RANDOM_REPLY_CHANCE=0.01
BACKUP_HOUR=3
BACKUP_MINUTE=0
GROUP_CHAT_LOG_RETENTION_DAYS=0
BACKUP_KEEP_DAYS=0
BACKUP_KEEP_COUNT=0
BACKUP_INCLUDE_GROUP_CHAT_LOGS=true
BACKUP_INCLUDE_IMAGE_LIBRARY=false
IMAGE_LIBRARY_OCR_ENABLED=false
IMAGE_LIBRARY_MAX_FILE_MB=10
IMAGE_LIBRARY_MAX_GROUP_MB=512
IMAGE_LIBRARY_MAX_GROUP_IMAGES=500
